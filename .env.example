# Copy to .env and fill in. Only keys for providers you want to benchmark are required.
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# Optional model overrides (provider model names change over time)
DEEPGRAM_MODEL=nova-3
OPENAI_STT_MODEL=whisper-1
ELEVENLABS_STT_MODEL=scribe_v1

# Live agent (defaults shown)
STT_PROVIDER=deepgram
LLM_MODEL=gpt-4.1
TTS_MODEL=eleven_flash_v2_5
# Leave empty for the plugin default voice; pick a Turkish-capable voice in ElevenLabs and paste its ID
TTS_VOICE_ID=
